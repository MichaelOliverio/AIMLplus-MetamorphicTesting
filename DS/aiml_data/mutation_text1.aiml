            <image>automi/automa.svg</image>
        </template>
    </category>
    <category intent="fsa-practical" argument="state" request="What is the initial state and what is the final state?">
        <acts>
            <act time="0">Ta:request</act>
        </acts>
        <frame>&lt;frame&gt;
            &lt;slot name=&quot;initialState&quot; value=&quot;?&quot;&quot;/&gt;
            &lt;slot name=&quot;finalStates&quot; value=&quot;?&quot;/&gt;
        &lt;/frame&gt;</frame>
        <template>
            q0 is the initial and the final state.
            <svgElement style-name="stroke" style-value="#04ed00">simbolo-q0</svgElement>
            <image>automi/automa.svg</image>
        </template>
    </category>
    <category intent="fsa-practical" argument="transition" wrong="['There are transitions between q0 and q0 in both directions: q0-&gt;q0 = 5, q0-&gt;q0 = 8.']" request="Is there a transition between q0 and q0?">
