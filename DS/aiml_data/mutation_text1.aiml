    <category intent="fsa-practical" argument="automaton" wrong="['The automaton has 7 states and 9 transitions.']" request="How many states and transitions does the automaton have?">
        <acts>
            <act time="0">Ta:request</act>
        </acts>
        <frame>
            
            
